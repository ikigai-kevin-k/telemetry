[Unit]
Description=Telemetry Agent Services for GC-ARO-001-2 (Promtail, Zabbix Agent, ZCAM Exporter)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/rnd/telemetry
# Use docker compose (v2) command
ExecStart=/usr/bin/docker compose -f /home/rnd/telemetry/docker-compose-GC-ARO-001-2-agent.yml up -d
ExecStop=/usr/bin/docker compose -f /home/rnd/telemetry/docker-compose-GC-ARO-001-2-agent.yml down
# Restart service if it fails
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
# Ensure network is ready before starting
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=multi-user.target


