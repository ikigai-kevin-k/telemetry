# Copy to byteplus-credentials.env and fill in real values (never commit the real file).
#   cp byteplus-credentials.env.example byteplus-credentials.env && chmod 600 byteplus-credentials.env
#
# BytePlus VMP credentials for Grafana datasource provisioning (optional if unused).
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=

# Optional: Slack webhook for Alertmanager (Alertmanager also reads SLACK_WEBHOOK_URL from
# the shell environment or a project-root .env file used by docker compose interpolation.)
# SLACK_WEBHOOK_URL=
